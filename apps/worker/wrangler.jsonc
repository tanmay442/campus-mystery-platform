{
  "name": "campus-mystery-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "development",
    // ADMIN_EMAILS stays empty here on purpose. The production value is set
    // via the Cloudflare dashboard / secrets, never committed to the repo.
    "ADMIN_EMAILS": ""
  },
  // All database_id values are real Cloudflare IDs. `--local` commands
  // still run against local state; `--remote` touches the named database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-mystery-dev",
      "database_id": "81b957f5-5c0e-49c3-9932-43d8e0f1325d",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "campus-mystery-media-dev"
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "ADMIN_EMAILS": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "campus-mystery-staging",
          "database_id": "a72a95ca-a5c0-49f7-b257-af17e05c5df6",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "campus-mystery-media-staging"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "ADMIN_EMAILS": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "campus-mystery-production",
          "database_id": "438ad759-3620-403b-9c91-788e966b377a",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "campus-mystery-media-production"
        }
      ]
    }
  }
}
