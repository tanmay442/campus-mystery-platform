{
  "name": "@campus/db",
  "version": "0.1.0",
  "private": true,
  "description": "D1 database foundation: Drizzle schema plus versioned SQL migrations.",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "drizzle-kit generate --dialect=sqlite --schema=./schema.ts --out=./migrations",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
